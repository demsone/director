#!/bin/zsh
set -eu
cd "${0:A:h}"
NODE="$(command -v node || true)"
if [[ -z "$NODE" && -x "$HOME/.local/bin/node" ]]; then NODE="$HOME/.local/bin/node"; fi
if [[ -z "$NODE" ]]; then print 'Node.js is required to open this preview.'; exit 1; fi
URL='http://127.0.0.1:4184'
if [[ "$(curl -fsS "$URL/__director_v4" 2>/dev/null || true)" != 'director-v4-visual' ]]; then
  if lsof -nP -iTCP:4184 -sTCP:LISTEN >/dev/null 2>&1; then print 'Port 4184 is in use by another app. Close that app and reopen Director v4.'; exit 1; fi
  nohup "$NODE" serve.mjs > /tmp/director-v4-visual.log 2>&1 < /dev/null &
  for attempt in {1..30}; do
    if curl -fsS "$URL/__director_v4" >/dev/null 2>&1; then break; fi
    sleep 0.1
  done
fi
if [[ "$(curl -fsS "$URL/__director_v4" 2>/dev/null || true)" != 'director-v4-visual' ]]; then print 'Preview did not start. See /tmp/director-v4-visual.log'; exit 1; fi
print "Director v4 visual review: $URL"
open "$URL"
