#!/bin/zsh
set -eu
cd "${0:A:h}"
prototype_url='http://127.0.0.1:4176/director-new-feedback.html'
if curl -fsS 'http://127.0.0.1:4176/screens.json' 2>/dev/null | /usr/bin/grep -q 'Director / New Feedback'; then
  print "Director v2.5 is already running at $prototype_url"
  open "$prototype_url"
  exit 0
fi
if lsof -nP -iTCP:4176 -sTCP:LISTEN >/dev/null 2>&1; then
  print 'Port 4176 is used by another program. Close that preview before opening Director v2.5.'
  exit 1
fi
prototype_python="$(command -v python3 || true)"
if [[ -z "$prototype_python" ]]; then
  print 'Python 3 is required to serve this static prototype.'
  exit 1
fi
mkdir -p .runtime
"$prototype_python" - <<'PY'
import subprocess
from pathlib import Path
import sys
root = Path.cwd()
with (root / '.runtime/server.log').open('ab') as log:
    process = subprocess.Popen([sys.executable, str(root / 'serve.py')],
        stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
(root / '.runtime/server.pid').write_text(str(process.pid))
PY
for attempt in {1..40}; do
  if curl -fsS 'http://127.0.0.1:4176/screens.json' >/dev/null 2>&1; then
    print "Director v2.5 visual prototype: $prototype_url"
    open "$prototype_url"
    exit 0
  fi
  sleep 0.25
done
print 'The preview did not start. See .runtime/server.log in the prototype folder.'
exit 1
