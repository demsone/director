#!/bin/bash
# Director launcher — starts the local Director app and opens it in your browser.
# Double-click "Director.command" (macOS) or run this file directly.

set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
APP="$ROOT/app"
PORT="${PORT:-4747}"
URL="http://127.0.0.1:$PORT"

cd "$APP"

# 1. Already running? Just open it.
if curl -s -m 2 "$URL/api/settings" >/dev/null 2>&1; then
  echo "Director is already running at $URL"
  open "$URL" 2>/dev/null || true
  exit 0
fi

# 2. Node.js 22.13+ is required (Director uses the built-in SQLite module).
if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is not installed. Install Node.js 22 or newer from https://nodejs.org and open Director again."
  read -r -p "Press Enter to close." _; exit 1
fi
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
NODE_MINOR="$(node -p 'process.versions.node.split(".")[1]')"
if [ "$NODE_MAJOR" -lt 22 ] || { [ "$NODE_MAJOR" -eq 22 ] && [ "$NODE_MINOR" -lt 13 ]; }; then
  echo "Director needs Node.js 22.13 or newer (found $(node -v)). Update Node.js and open Director again."
  read -r -p "Press Enter to close." _; exit 1
fi

# 3. Install dependencies on first run or when they change.
if [ ! -d node_modules ] || [ package.json -nt node_modules ]; then
  echo "Installing dependencies (first run only, about a minute)…"
  npm install --no-audit --no-fund
  touch node_modules
fi

# 4. Build the interface when the source is newer than the last build.
if [ ! -f dist/index.html ] || [ -n "$(find src index.html -newer dist/index.html -print -quit)" ]; then
  echo "Building Director…"
  npm run build
fi

# 5. Start the server and open the browser once it answers.
echo "Starting Director at $URL"
( for _ in $(seq 1 40); do
    if curl -s -m 1 "$URL/api/settings" >/dev/null 2>&1; then open "$URL" 2>/dev/null || true; exit 0; fi
    sleep 0.5
  done ) &
echo "Keep this window open while you use Director. Close it (or press Ctrl+C) to stop."
exec env PORT="$PORT" NODE_NO_WARNINGS=1 node server/index.js
