#!/bin/zsh
set -eu
cd "$(dirname "$0")"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v node >/dev/null 2>&1; then
  echo 'Director needs Node.js 22.13 or newer. Install Node.js, then reopen Director.command.'
  exit 1
fi
if ! node -e 'const [major,minor]=process.versions.node.split(".").map(Number);process.exit(major>22 || major===22 && minor>=13 ? 0 : 1)'; then
  echo 'Director needs Node.js 22.13 or newer.'
  exit 1
fi
DIRECTOR_PORT="${PORT:-4177}"
export PORT="$DIRECTOR_PORT"
DIRECTOR_URL="http://127.0.0.1:$DIRECTOR_PORT"
director_is_ready() {
  curl -fsS --max-time 2 "$DIRECTOR_URL/api/health" 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{process.exit(JSON.parse(s).app==="director-v4"?0:1)}catch{process.exit(1)}})'
}
if director_is_ready; then
  echo "Director is already running at $DIRECTOR_URL"
  [[ "${DIRECTOR_NO_OPEN:-0}" == 1 ]] || open "$DIRECTOR_URL"
  exit 0
fi
node server.mjs &
DIRECTOR_PID=$!
trap 'kill "$DIRECTOR_PID" 2>/dev/null || true' EXIT INT TERM
for attempt in {1..50}; do
  if ! kill -0 "$DIRECTOR_PID" 2>/dev/null; then
    echo 'Director could not start. Check the message above; another app may be using the port.'
    exit 1
  fi
  if director_is_ready; then
    echo "Open Director at $DIRECTOR_URL. Leave this window open while using it."
    [[ "${DIRECTOR_NO_OPEN:-0}" == 1 ]] || open "$DIRECTOR_URL"
    wait "$DIRECTOR_PID"
    exit $?
  fi
  sleep 0.1
done
echo 'Director did not become ready. Reopen the launcher to retry.'
exit 1
