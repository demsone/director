#!/bin/zsh
# Starts the approved Astra Director v4 interface without requiring a terminal command.
set -eu

ROOT="${0:A:h}"
PORT=4184
URL="http://127.0.0.1:${PORT}"
LOG="${TMPDIR:-/tmp}/director-v4.log"

cd "$ROOT"

if ! command -v node >/dev/null 2>&1; then
  print 'Director v4 needs Node.js. Install Node.js, then open this file again.'
  exit 1
fi

is_director_running() {
  [[ "$(curl --max-time 1 -fsS "$URL/__director_v4" 2>/dev/null || true)" == 'director-v4-feedback-new-v1' ]]
}

if ! is_director_running; then
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    print "Port ${PORT} is already being used by another app. Close it, then open Director v4 again."
    exit 1
  fi

  nohup node "$ROOT/visual-v4/serve.mjs" >"$LOG" 2>&1 < /dev/null &

  for attempt in {1..50}; do
    if is_director_running; then break; fi
    sleep 0.1
  done
fi

if ! is_director_running; then
  print "Director v4 did not start. See ${LOG} for details."
  exit 1
fi

print "Director v4: ${URL}"
open "$URL"
