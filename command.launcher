#!/bin/zsh
# Starts the functional Director v4 app without requiring a terminal command.
set -eu

ROOT="${0:A:h}"
PORT=5173
URL="http://127.0.0.1:${PORT}"
LOG="${TMPDIR:-/tmp}/director-v4-functional.log"

cd "$ROOT"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  print 'Director v4 needs Node.js and npm. Install Node.js, then open this file again.'
  exit 1
fi

is_director_running() {
  curl --max-time 1 -fsS "$URL" 2>/dev/null | grep -Fq '<title>Director v4</title>'
}

if ! is_director_running; then
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    print "Port ${PORT} is already being used by another app. Close it, then open Director v4 again."
    exit 1
  fi

  if [[ ! -x node_modules/.bin/vite ]]; then
    print 'Installing Director v4 dependencies for the first launch…'
    npm ci
  fi

  nohup npm run dev -- --host 127.0.0.1 --port "$PORT" --strictPort >"$LOG" 2>&1 < /dev/null &

  for attempt in {1..50}; do
    if is_director_running; then break; fi
    sleep 0.1
  done
fi

if ! is_director_running; then
  print "Director v4 did not start. See ${LOG} for details."
  exit 1
fi

print "Director v4: ${URL}"
open "$URL"
